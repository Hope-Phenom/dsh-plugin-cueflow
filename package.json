{
  "name": "dsh-plugin-cueflow",
  "version": "0.1.0",
  "private": false,
  "description": "CueFlow — ComfyUI-style workflow orchestration for DeepSeek Harness: node canvas, typed links, DSH Skill/Command/Agent/Shell/FS nodes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hope-Phenom/dsh-plugin-cueflow.git"
  },
  "homepage": "https://github.com/Hope-Phenom/dsh-plugin-cueflow",
  "bugs": {
    "url": "https://github.com/Hope-Phenom/dsh-plugin-cueflow/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "workflow",
    "comfyui",
    "agent"
  ],
  "type": "module",
  "main": "lib/index.js",
  "icon": "./assets/icon.svg",
  "license": "MIT",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "shared",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "ui": "vite --config vite.config.js",
    "ui:build": "vite build --config vite.config.js",
    "ui:shot": "node scripts/screenshot-ui.mjs",
    "e2e": "playwright test",
    "lint": "eslint .",
    "bench": "node scripts/bench.mjs",
    "bench:runs": "node scripts/bench-runs.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "prepublishOnly": "pnpm build && pnpm verify:pack"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
